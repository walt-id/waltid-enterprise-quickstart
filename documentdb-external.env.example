# Settings for docker-compose-documentdb-external.yml, see docs/documentdb-existing-postgres.md.
# Copy to documentdb-external.env (gitignored). Kept out of .env on purpose: .env is also read by the
# bundled DocumentDB stack, which must never see this connection string.

DOCUMENTDB_CONNECTION_STRING='mongodb://waltid:<url-encoded password>@db.example.com:10260/?directConnection=true&retryWrites=false&tls=true'
DOCUMENTDB_TRUSTSTORE_PASSWORD=<trust store password>

# Uncomment only if the gateway certificate's name cannot match the host you dial.
# DOCUMENTDB_INVALID_HOSTNAME_ALLOWED=true

# Host port of the API (default 7500). Set e.g. 7600 to run next to the bundled DocumentDB stack,
# then run the CLI with PORT=7600.
# ENTERPRISE_API_PORT=7600
