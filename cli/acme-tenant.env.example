# ============================================================================
# Acme Tenant Configuration
# ============================================================================
# Copy this file to acme-tenant.env and configure with your values.
# This file is used by the CLI to set up the acme-tenant.
# ============================================================================

# Base URL for the issuer and verifier services
# This is the public URL where the services will be accessible
ACME_TENANT_BASE_URL=http://localhost:8080

# Alternative: Use ISSUER_BASE_URL if ACME_TENANT_BASE_URL is not set
# ISSUER_BASE_URL=http://localhost:8080

# Base URL for VCT (Verifiable Credential Type) values
# Defaults to ACME_TENANT_BASE_URL if not specified
# VCT_BASE_URL=http://localhost:8080

# Tenant name
# Defaults to 'acme-tenant' if not specified
ACME_TENANT=acme-tenant

# Keycloak OAuth2 endpoints and credentials
KEYCLOAK_AUTHORIZE_URL=http://keycloak:8080/realms/master/protocol/openid-connect/auth
KEYCLOAK_ACCESS_TOKEN_URL=http://keycloak:8080/realms/master/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=issuer_api
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Default scopes for Keycloak authentication
# Comma-separated list, defaults to 'openid,profile' if not specified
KEYCLOAK_DEFAULT_SCOPES=openid,profile

# Issuer Display Configuration
# These values are used to configure how the issuer is displayed in wallets
ACME_ISSUER_DISPLAY_NAME=Acme Credential Issuer
ACME_ISSUER_DISPLAY_LOCALE=en-US
ACME_ISSUER_DISPLAY_LOGO_URI=http://localhost:8080/logo.png
ACME_ISSUER_DISPLAY_LOGO_ALT_TEXT=Acme issuer logo

# Verifier Display Configuration
# These values are used to configure how the verifier is displayed
ACME_VERIFIER_CLIENT_NAME=Acme Credential Verifier
ACME_VERIFIER_LOGO_URI=http://localhost:8080/logo.png
