# Copy to vault.env, which is ignored. Pass both --env-file .env and --env-file vault.env.
# A build containing https://github.com/walt-id/waltid-identity-enterprise/pull/908 is required.
VAULT_ENTERPRISE_IMAGE=

# PostgreSQL selection. Switch the three database values below together for MongoDB.
VAULT_DATABASE_CONFIG=./config/database-vault-postgresql.conf
VAULT_DATABASE_CONNECTION_STRING=jdbc:postgresql://postgres.example.test:5432/waltid_enterprise?sslmode=verify-full&sslrootcert=/run/vault-tls/postgres-ca.pem
VAULT_DATABASE_NAME=waltid_enterprise
# VAULT_POSTGRESQL_SCHEMA=public

# MongoDB selection, using an external replica set.
# VAULT_DATABASE_CONFIG=./config/database-vault-mongodb.conf
# VAULT_DATABASE_CONNECTION_STRING=mongodb://mongo.example.test:27017/?replicaSet=rs0&tls=true
# VAULT_DATABASE_NAME=waltid-enterprise
# VAULT_MONGODB_AUTH_SOURCE=admin

VAULT_ADDRESS=https://vault.example.test:8200
VAULT_DATABASE_MOUNT=database
VAULT_DATABASE_ROLE=enterprise-api
VAULT_DATABASE_ROLE_TYPE=DYNAMIC
# VAULT_NAMESPACE=admin/team/

# Existing host directories. An external Vault Agent or equivalent maintains a file named token.
VAULT_TOKEN_DIRECTORY=./secrets/vault-token
VAULT_TLS_DIRECTORY=./certs/vault

# Optional direct API port. Use the same PORT when running the TypeScript CLI.
ENTERPRISE_API_PORT=7500
