# Enterprise API
ENTERPRISE_API_DOCKER_IMAGE_TAG=stable

# Encrypts the persisted license credential and installation key in MongoDB.
#
# Left unset on purpose. The Enterprise API generates a random secret on first start and shares it
# between replicas through MongoDB, so the quickstart works without configuring anything.
#
# Setting it gives stronger protection, because the secret then lives outside the database and a copy
# of the database alone cannot be used. Use at least 32 characters, the same value on every replica,
# and back it up with MongoDB. Changing it later makes existing license state unreadable.
#
# Do not put a shared example value here. A published secret protects nothing.
LICENSE_STATE_ENCRYPTION_KEY=

# MongoDB Environment
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=password

# Host ports for the database tooling. Change these if the host already runs something on
# them; the Enterprise API always reaches MongoDB as mongo:27017 on the compose network, so
# only your access from the host is affected.
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

