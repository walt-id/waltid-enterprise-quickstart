# Enterprise API
ENTERPRISE_API_DOCKER_IMAGE_TAG=stable

# Encrypts the persisted license credential and installation key in MongoDB.
# Must be at least 32 characters. Changing this value makes existing license state unreadable.
LICENSE_STATE_ENCRYPTION_KEY=waltid-enterprise-quickstart-license-state-key

# MongoDB Environment
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=password

