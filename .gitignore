# License material for offline/air-gapped activation. installation-key.json holds a private key and
# must never be committed. .gitkeep is tracked so the Docker Compose bind mount source always exists.
/license/*
!/license/.gitkeep

# Trust store (and any certificate material) for a DocumentDB gateway you operate yourself, see
# docs/documentdb-existing-postgres.md.
/certs/

# Local crash and profiling artifacts that get dropped into the bind-mounted config/ directory.
*.hprof
*.jfr
config/otel-agent.jar
.env
